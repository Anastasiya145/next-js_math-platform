{
  "openapi": "3.1.0",
  "info": {
    "title": "Math Tutor Platform API",
    "version": "1.0.0",
    "description": "Authenticated REST API for the tutoring platform. Sign in through the application before sending requests. Teacher-only operations require a teacher session; student operations are restricted to the signed-in student's account. The API uses JSON unless a route documents multipart uploads or file downloads."
  },
  "servers": [{ "url": "/", "description": "Current application origin" }],
  "tags": [
    { "name": "Students" },
    { "name": "Assignments" },
    { "name": "Schedule" },
    { "name": "Payments" },
    { "name": "Student portal" },
    { "name": "Materials" },
    { "name": "Textbooks" },
    { "name": "NUSH" },
    { "name": "Google Drive" }
  ],
  "paths": {
    "/api/students": {
      "get": {
        "tags": ["Students"],
        "summary": "List students",
        "description": "Teacher only. Returns student profiles and account-facing fields; password hashes are never returned.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Students"],
        "summary": "Create a student account",
        "description": "Teacher only. For the languages site, provide distinct baseLanguage and targetLanguage values (fr or ru). The temporary password is never returned.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentInput" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Students"],
        "summary": "Update a student",
        "description": "Teacher only. Pass the student ID as the id query parameter. Request fields follow the student creation schema; temporaryPassword is optional when updating.",
        "parameters": [{ "$ref": "#/components/parameters/StudentIdQuery" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/StudentUpdateInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Students"],
        "summary": "Delete a student",
        "description": "Teacher only. Deletes the student identified by the id query parameter.",
        "parameters": [{ "$ref": "#/components/parameters/StudentIdQuery" }],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/assignments": {
      "get": {
        "tags": ["Assignments"],
        "summary": "List assignments",
        "description": "Teachers receive assignments for review; students receive only their own assignments.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Assignments"],
        "summary": "Create and assign homework",
        "description": "Teacher only. studentIds must contain at least one positive ID. Resource URLs must use HTTP or HTTPS.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssignmentInput" },
              "example": {
                "title": "Fractions practice",
                "instructions": "Complete exercises 1-5.",
                "resourceUrl": "https://example.test/work",
                "dueAt": "2026-10-28T15:00:00.000Z",
                "nextLessonAt": "2026-10-29T14:00:00.000Z",
                "studentIds": [42]
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/assignments/{homeworkId}": {
      "parameters": [{ "$ref": "#/components/parameters/HomeworkId" }],
      "patch": {
        "tags": ["Assignments"],
        "summary": "Update an assignment",
        "description": "Teacher only. Accepts a JSON assignment update.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AssignmentUpdateInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Assignments"],
        "summary": "Delete an assignment",
        "description": "Teacher only.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/assignments/{homeworkId}/grade": {
      "parameters": [{ "$ref": "#/components/parameters/HomeworkId" }],
      "patch": {
        "tags": ["Assignments"],
        "summary": "Grade a submission",
        "description": "Teacher only. Records a score and feedback for the student's submission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GradeInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/assignments/{homeworkId}/no-homework": {
      "parameters": [{ "$ref": "#/components/parameters/HomeworkId" }],
      "post": {
        "tags": ["Assignments"],
        "summary": "Mark homework as not done",
        "description": "Student only. Marks the signed-in student's assignment as no_homework.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/assignments/{homeworkId}/submission": {
      "parameters": [{ "$ref": "#/components/parameters/HomeworkId" }],
      "get": {
        "tags": ["Assignments"],
        "summary": "Download a submitted file",
        "description": "Teacher only. Requires the assigned studentId and Drive fileId query parameters.",
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "fileId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "File content",
            "content": {
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Assignments"],
        "summary": "Upload submission files",
        "description": "Student only. Send one or more file fields as multipart/form-data. File size and type limits are documented in src/lib/homework-files.ts.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "413": { "$ref": "#/components/responses/Error" },
          "415": { "$ref": "#/components/responses/Error" },
          "502": { "$ref": "#/components/responses/Error" },
          "503": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "tags": ["Schedule"],
        "summary": "List lessons in a date range",
        "description": "Teacher only. from and to are ISO calendar dates; an optional comma-separated studentIds filter may be supplied. The date range is limited to 92 days.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "studentIds",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Schedule"],
        "summary": "Create a one-off lesson",
        "description": "Teacher only. A duplicate lesson slot returns 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LessonInput" },
              "example": {
                "studentId": 42,
                "startsAt": "2026-10-29T14:00:00.000Z",
                "durationMinutes": 60
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "409": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Schedule"],
        "summary": "Update a lesson",
        "description": "Teacher only. Accepts a JSON lesson update.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LessonUpdateInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Schedule"],
        "summary": "Delete a lesson",
        "description": "Teacher only. Identify a lesson with its studentId and scheduledAt query parameters.",
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "scheduledAt",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/students/{studentId}/schedule": {
      "put": {
        "tags": ["Schedule"],
        "summary": "Replace weekly schedule and hourly rate",
        "description": "Teacher only. Replaces the complete set of recurring weekly slots. weekday uses 1-7; startTime is local HH:mm time.",
        "parameters": [{ "$ref": "#/components/parameters/StudentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecurringScheduleInput"
              },
              "example": {
                "hourlyRate": 1500,
                "startsOn": "2026-10-26",
                "slots": [
                  { "weekday": 1, "startTime": "16:00", "durationMinutes": 60 },
                  { "weekday": 4, "startTime": "17:30", "durationMinutes": 45 }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/payments": {
      "get": {
        "tags": ["Payments"],
        "summary": "List payments",
        "description": "Teacher only. from and to are ISO calendar dates and the range is limited by the route.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Payments"],
        "summary": "Record a payment",
        "description": "Teacher only. amount is an integer UAH amount.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentInput" },
              "example": {
                "studentId": 42,
                "paidOn": "2026-10-21",
                "amount": 1500,
                "note": "October"
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "tags": ["Payments"],
        "summary": "Update a payment",
        "description": "Teacher only. Include the payment id in the JSON body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentUpdateInput" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Payments"],
        "summary": "Delete a payment",
        "description": "Teacher only.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/student/dashboard": {
      "get": {
        "tags": ["Student portal"],
        "summary": "Get the student dashboard",
        "description": "Students receive their own dashboard. Teachers may pass studentId to inspect a student's dashboard.",
        "parameters": [
          {
            "name": "studentId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/student/change-password": {
      "post": {
        "tags": ["Student portal"],
        "summary": "Change the signed-in student's password",
        "description": "Student only. Password values are accepted in the request but are never returned or logged in this documentation.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/student/language": {
      "patch": {
        "tags": ["Student portal"],
        "summary": "Update language preferences",
        "description": "Student only. Updates the signed-in student's language preferences.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/materials": {
      "get": {
        "tags": ["Materials"],
        "summary": "List class materials",
        "description": "Teacher only.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Materials"],
        "summary": "Manage class materials",
        "description": "Teacher only. The JSON action field selects the material operation.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/nush": {
      "get": {
        "tags": ["NUSH"],
        "summary": "List NUSH topics and materials",
        "description": "Teacher only. grade is required (1-11); topicId is optional and returns materials for that topic.",
        "parameters": [
          {
            "name": "grade",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1, "maximum": 11 }
          },
          {
            "name": "topicId",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["NUSH"],
        "summary": "Manage NUSH topics and materials",
        "description": "Teacher only. The JSON action field selects the topic or material operation.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/textbooks": {
      "get": {
        "tags": ["Textbooks"],
        "summary": "List textbooks",
        "description": "Teacher only.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "tags": ["Textbooks"],
        "summary": "Create a textbook",
        "description": "Teacher only. Resource URLs must use HTTP or HTTPS.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "201": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/textbooks/{textbookId}": {
      "parameters": [{ "$ref": "#/components/parameters/TextbookId" }],
      "patch": {
        "tags": ["Textbooks"],
        "summary": "Update a textbook",
        "description": "Teacher only.",
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "tags": ["Textbooks"],
        "summary": "Delete a textbook",
        "description": "Teacher only.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/students/{studentId}/report": {
      "get": {
        "tags": ["Students"],
        "summary": "Download a student report",
        "description": "Teacher only.",
        "parameters": [{ "$ref": "#/components/parameters/StudentId" }],
        "responses": {
          "200": {
            "description": "PDF report",
            "content": {
              "application/pdf": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/students/{studentId}/drive-folder": {
      "put": {
        "tags": ["Google Drive"],
        "summary": "Set a student's Drive folder",
        "description": "Teacher only.",
        "parameters": [{ "$ref": "#/components/parameters/StudentId" }],
        "requestBody": { "$ref": "#/components/requestBodies/JsonObject" },
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "400": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/teacher/drive-status": {
      "get": {
        "tags": ["Google Drive"],
        "summary": "Get Drive connection status",
        "description": "Teacher only. Returns connection state; never returns Google credentials or tokens.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/teacher/drive-picker": {
      "get": {
        "tags": ["Google Drive"],
        "summary": "Get Drive picker configuration",
        "description": "Teacher only. Returns the configuration needed to open the Google Drive picker.",
        "responses": {
          "200": { "$ref": "#/components/responses/Data" },
          "403": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "StudentId": {
        "name": "studentId",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "StudentIdQuery": {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "HomeworkId": {
        "name": "homeworkId",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      },
      "TextbookId": {
        "name": "textbookId",
        "in": "path",
        "required": true,
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "requestBodies": {
      "JsonObject": {
        "required": true,
        "content": {
          "application/json": {
            "schema": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    "responses": {
      "Data": {
        "description": "Successful JSON response",
        "content": {
          "application/json": {
            "schema": { "type": "object", "properties": { "data": {} } }
          }
        }
      },
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } }
      },
      "StudentInput": {
        "type": "object",
        "required": ["name", "grade", "email", "temporaryPassword", "siteType"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "grade": { "type": "integer", "minimum": 1, "maximum": 11 },
          "email": { "type": "string", "format": "email" },
          "temporaryPassword": {
            "type": "string",
            "writeOnly": true,
            "description": "Initial password. Never include real credentials in shared examples."
          },
          "siteType": { "type": "string", "enum": ["math", "languages"] },
          "baseLanguage": {
            "type": ["string", "null"],
            "enum": ["fr", "ru", null]
          },
          "targetLanguage": {
            "type": ["string", "null"],
            "enum": ["fr", "ru", null]
          }
        }
      },
      "StudentUpdateInput": {
        "type": "object",
        "required": ["name", "grade", "email", "siteType"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "grade": { "type": "integer", "minimum": 1, "maximum": 11 },
          "email": { "type": "string", "format": "email" },
          "temporaryPassword": {
            "type": "string",
            "writeOnly": true,
            "description": "Optional replacement password. Never include real credentials in shared examples."
          },
          "siteType": { "type": "string", "enum": ["math", "languages"] },
          "baseLanguage": {
            "type": ["string", "null"],
            "enum": ["fr", "ru", null]
          },
          "targetLanguage": {
            "type": ["string", "null"],
            "enum": ["fr", "ru", null]
          }
        }
      },
      "AssignmentInput": {
        "type": "object",
        "required": ["title", "studentIds"],
        "properties": {
          "title": { "type": "string", "maxLength": 160 },
          "instructions": { "type": "string", "maxLength": 4000 },
          "resourceUrl": { "type": "string", "format": "uri" },
          "dueAt": { "type": ["string", "null"], "format": "date-time" },
          "nextLessonAt": { "type": ["string", "null"], "format": "date-time" },
          "studentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "AssignmentUpdateInput": {
        "type": "object",
        "required": ["title", "studentIds"],
        "properties": {
          "title": { "type": "string", "maxLength": 160 },
          "instructions": { "type": "string", "maxLength": 4000 },
          "resourceUrl": { "type": "string", "format": "uri" },
          "nextLessonAt": { "type": ["string", "null"], "format": "date-time" },
          "studentIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "GradeInput": {
        "type": "object",
        "required": ["studentId", "score"],
        "properties": {
          "studentId": { "type": "integer", "minimum": 1 },
          "score": { "type": "integer", "minimum": 0, "maximum": 12 },
          "feedback": { "type": "string", "maxLength": 2000 }
        }
      },
      "LessonInput": {
        "type": "object",
        "required": ["studentId", "startsAt", "durationMinutes"],
        "properties": {
          "studentId": { "type": "integer", "minimum": 1 },
          "startsAt": { "type": "string", "format": "date-time" },
          "durationMinutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 240
          }
        }
      },
      "LessonUpdateInput": {
        "type": "object",
        "required": ["studentId", "scheduledAt"],
        "properties": {
          "studentId": { "type": "integer", "minimum": 1 },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["planned", "held", "cancelled"]
          },
          "startsAt": { "type": ["string", "null"], "format": "date-time" },
          "topicId": { "type": ["integer", "null"], "minimum": 1 }
        }
      },
      "RecurringScheduleInput": {
        "type": "object",
        "required": ["hourlyRate", "startsOn", "slots"],
        "properties": {
          "hourlyRate": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "startsOn": { "type": "string", "format": "date" },
          "slots": {
            "type": "array",
            "maxItems": 14,
            "items": { "$ref": "#/components/schemas/LessonSlotInput" }
          }
        }
      },
      "LessonSlotInput": {
        "type": "object",
        "required": ["weekday", "startTime", "durationMinutes"],
        "properties": {
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "startTime": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "durationMinutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 240
          }
        }
      },
      "PaymentInput": {
        "type": "object",
        "required": ["studentId", "paidOn", "amount"],
        "properties": {
          "studentId": { "type": "integer", "minimum": 1 },
          "paidOn": { "type": "string", "format": "date" },
          "amount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "note": { "type": "string", "maxLength": 200 }
        }
      },
      "PaymentUpdateInput": {
        "type": "object",
        "required": ["id", "paidOn", "amount"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "paidOn": { "type": "string", "format": "date" },
          "amount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "note": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
